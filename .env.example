# SobatWeb Environment Variables

# Node & Platform
NODE_ENV=development
PORT=3000
API_PORT=4000
BASE_DOMAIN=localhost:3000
PUBLIC_SITE_PROTOCOL=http

# Database
# Use PostgreSQL URL, or leave blank to use embedded SQLite/PGlite mode for standalone dev/test
DATABASE_URL=postgresql://sobatweb:sobatweb_secret@localhost:5432/sobatweb_db

# Redis (optional, falls back to memory cache if unavailable)
REDIS_URL=redis://localhost:6379

# JWT & Session Secret
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_sobatweb_2026
SESSION_COOKIE_NAME=sobatweb_session

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sobatweb-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Super Admin Initial Seed (used only on initial migration/seed)
SUPERADMIN_EMAIL=superadmin@sobat.com
SUPERADMIN_PASSWORD=SuperAdminPassword123!
SUPERADMIN_NAME="Super Administrator"
